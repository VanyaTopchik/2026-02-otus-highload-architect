          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">// Для first name
String original1 = vars.get(&quot;name_part_1&quot;)
if (original1 != null &amp;&amp; original1.length() &gt; 0) {
    int len = original1.length()
    String result
    if (len &lt; 3) {
        result = original1
    } else {
        Random rand = new Random()
        int minLen = 3
        int maxLen = len
        int subLen = minLen + rand.nextInt(maxLen - minLen + 1)
        int start = rand.nextInt(len - subLen + 1)
        result = original1.substring(start, start + subLen)
    }
    vars.put(&quot;random_first_name_part&quot;, result)
}
// Для last name
String original2 = vars.get(&quot;name_part_2&quot;)
if (original2 != null &amp;&amp; original2.length() &gt; 0) {
    int len = original2.length()
    String result
    if (len &lt; 3) {
        result = original2
    } else {
        Random rand = new Random()
        int minLen = 3
        int maxLen = len
        int subLen = minLen + rand.nextInt(maxLen - minLen + 1)
        int start = rand.nextInt(len - subLen + 1)
        result = original2.substring(start, start + subLen)
    }
    vars.put(&quot;random_last_name_part&quot;, result)
}</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
